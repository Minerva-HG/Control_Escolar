# Copia este archivo como .env y ajusta los valores antes de levantar la aplicacion.

# --- Servidor ---
NODE_ENV=development
PORT=3000

# --- Base de datos PostgreSQL ---
# Cuando se usa docker compose el host debe ser el nombre del servicio: "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=control_seguimiento
POSTGRES_USER=seguimiento
POSTGRES_PASSWORD=cambia_esta_password

# --- Seguridad ---
# Debe tener al menos 32 caracteres. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio_min_32
SESSION_HOURS=12

# --- Cuenta docente creada por el seed ---
SEED_TEACHER_NAME=Maestra Titular
SEED_TEACHER_EMAIL=maestra@escuela.mx
SEED_TEACHER_PASSWORD=Escuela2026!

# --- Datos institucionales mostrados en la interfaz ---
SCHOOL_NAME=Escuela Ramon Corona
SCHOOL_CYCLE=2026 - 2027
